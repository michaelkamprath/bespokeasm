{
  "cpu": "6502",
  "assembler": "ca65 2.18 + ld65",
  "origin": 32768,
  "source": [
    ".org $8000",
    "ZP_PTR  = $20",
    "COUNT   = 10",
    "PORTB   = $6000",
    "reset:  ldx #$FF",
    "        txs",
    "        cld",
    "        lda #<message",
    "        sta ZP_PTR",
    "        lda #>message",
    "        sta ZP_PTR+1",
    "        ldy #0",
    "loop:   lda (ZP_PTR),y",
    "        beq done",
    "        sta PORTB",
    "        iny",
    "        bne loop",
    "done:   lda #COUNT*2+1",
    "        lda #'A'",
    "        lda #%10101010",
    "        and #$0F",
    "        ora #<(table+$100)",
    "        cmp #COUNT-1",
    "        bcc *+5",
    "        jmp (vector)",
    "        ldx table,y",
    "        lda table+2,x",
    "        sta table+COUNT",
    "        sta ZP_PTR,x",
    "        ldy ZP_PTR+1,x",
    "        stx ZP_PTR,y",
    "        lda (ZP_PTR,x)",
    "        asl",
    "        rol a",
    "        lsr table",
    "        inc ZP_PTR",
    "        dec table,x",
    "        bit PORTB",
    "        jsr sub",
    "        bpl *",
    "        bmi *-2",
    "sub:    pha",
    "        php",
    "        plp",
    "        pla",
    "        rts",
    "irq:    rti",
    "table:  .byte 1, 2, 3, \"abc\", 0",
    "message: .byte \"Hello\", 0",
    "vector: .word reset, done, irq",
    "        .res 4",
    "        .res 2, $FF",
    "        .word $1234, table+1"
  ],
